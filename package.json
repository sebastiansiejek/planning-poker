{
  "name": "planning-poker",
  "version": "1.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky",
    "format": "eslint --fix . && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty",
    "preinstall": "pnpm dlx only-allow pnpm",
    "test": "jest && pnpm dlx playwright test",
    "test:unit": "jest",
    "test:e2e": "pnpm dlx playwright test",
    "test:e2e:watch": "pnpm dlx playwright test --ui",
    "playwright:codegen": "pnpm dlx playwright codegen",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "supabase:start": "pnpm dlx supabase start"
  },
  "engines": {
    "node": "^24.14.0",
    "pnpm": ">=8"
  },
  "dependencies": {
    "@auth/firebase-adapter": "^2.10.0",
    "@commitlint/types": "^19.8.1",
    "@headlessui/react": "^2.2.7",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.2.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/eslint-plugin-next": "^15.5.2",
    "@popperjs/core": "^2.11.8",
    "@prisma/client": "6.15.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10",
    "@supabase/ssr": "^0.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@typescript-eslint/parser": "^8.41.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "eslint-plugin-unicorn": "^60.0.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.12",
    "next": "15.5.2",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.5",
    "next-safe-action": "^8.0.10",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "prisma": "^6.15.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "radix-ui": "link:radix-ui",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "react-popper": "^2.3.0",
    "react-slot": "^0.1.2",
    "server-only": "^0.0.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@mermaid-js/mermaid-cli": "^11.9.0",
    "@playwright/test": "^1.55.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash.random": "^3.2.9",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.16.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.1.1",
    "jest-environment-jsdom": "^30.1.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma-erd-generator": "^2.0.4",
    "semantic-release": "^24.2.7",
    "supabase": "^2.39.2",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "protobufjs",
      "puppeteer",
      "sharp",
      "supabase",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "@sentry/cli",
      "unrs-resolver"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.30.3",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "download"
    }
  }
}
