{
  "name": "planning-poker",
  "version": "1.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky",
    "format": "next lint --fix && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty",
    "preinstall": "npx only-allow pnpm",
    "test": "jest && npx playwright test",
    "test:unit": "jest",
    "test:e2e": "npx playwright test",
    "test:e2e:watch": "npx playwright test --ui",
    "playwright:codegen": "npx playwright codegen",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": "^22.14.0",
    "pnpm": ">=8"
  },
  "dependencies": {
    "@auth/firebase-adapter": "^2.9.1",
    "@commitlint/types": "^19.8.1",
    "@headlessui/react": "^2.2.4",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.1.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/eslint-plugin-next": "^15.3.3",
    "@popperjs/core": "^2.11.8",
    "@prisma/client": "6.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "^9.27.0",
    "@tanstack/react-table": "^8.21.3",
    "@typescript-eslint/parser": "^8.33.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "eslint-plugin-unicorn": "^59.0.1",
    "firebase": "^11.9.0",
    "firebase-admin": "^13.4.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.513.0",
    "motion": "^12.16.0",
    "next": "15.3.3",
    "next-auth": "^4.24.11",
    "next-intl": "^4.1.0",
    "next-safe-action": "^8.0.2",
    "next-themes": "^0.4.6",
    "prisma": "^6.9.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "radix-ui": "link:radix-ui",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.57.0",
    "react-popper": "^2.3.0",
    "react-slot": "^0.1.2",
    "server-only": "^0.0.1",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@mermaid-js/mermaid-cli": "^11.4.2",
    "@playwright/test": "^1.52.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash.random": "^3.2.9",
    "@types/node": "^22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "prisma-erd-generator": "^2.0.4",
    "semantic-release": "^24.2.5",
    "tailwindcss": "^4.1.8",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "volta": {
    "node": "22.14.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.12",
      "@types/react-dom": "19.0.4"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "prisma",
      "puppeteer",
      "sharp",
      "vue-demi"
    ]
  }
}
