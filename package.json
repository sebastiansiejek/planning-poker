{
  "name": "planning-poker",
  "version": "1.9.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky",
    "format": "eslint --fix . && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty",
    "test": "jest && pnpm exec playwright test",
    "test:unit": "jest",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:watch": "pnpm exec playwright test --ui",
    "playwright:codegen": "pnpm exec playwright codegen",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:status": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js migrate status",
    "postinstall": "prisma generate",
    "supabase:start": "pnpm exec supabase start"
  },
  "engines": {
    "node": "^24.21.0",
    "pnpm": "10.30.3"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@popperjs/core": "^2.11.8",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "11.4.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.9",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-popper": "^2.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/cz-commitlint": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "9.39.5",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/lodash.random": "^3.2.9",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "prisma-erd-generator": "^2.5.0",
    "semantic-release": "^25.0.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.29.0": "7.29.7",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "@parcel/watcher@<2.6.0": "^2.6.0",
      "baseline-browser-mapping@2.10.10": "2.11.27",
