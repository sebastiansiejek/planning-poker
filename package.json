      "defu@6.1.4": "6.1.7",
      "diff@>=4.0.0 <4.0.4": "^4.0.4",
      "dompurify@<3.4.13": "^3.4.13",
      "esbuild@0.27.4": "0.28.2",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8",
      "flatted@<3.4.2": "^3.4.2",
      "handlebars@>=4.0.0 <4.7.9": "^4.7.9",
      "ip-address@<10.7.1": "^10.7.1",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "mermaid@>=11.0.0 <11.16.1": "^11.17.2",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.9",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.7",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "^6.1.4",
      "postcss@<8.5.23": "^8.5.23",
      "preact@10.28.1": "10.29.8",
      "tar@<7.5.21": "^7.5.21",
      "tmp@<0.2.6": "^0.2.6",
      "undici@<6.28.1": "^6.28.1",
      "undici@>=7.0.0 <7.29.1": "^7.30.0",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "ws@>=8.0.0 <8.21.0": "^8.22.0",
      "yaml@>=2.0.0 <2.8.3": "^2.9.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "puppeteer",
      "sharp",
      "supabase",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "@sentry/cli",
      "unrs-resolver"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.30.3",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
